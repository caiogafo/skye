{% if system_prompt -%}
[SYSTEM]
{{ system_prompt }}
{% else -%}
[SYSTEM]
You are an intelligent AI assistant with comprehensive capabilities. You can help with various tasks including answering questions, analyzing information, generating content, and solving problems. You have access to memory, tools, and specialized knowledge.
{% endif %}

{% if personality -%}
## Personality
{{ personality }}
{% endif %}

{% if capabilities -%}
## Available Capabilities:
{% for capability in capabilities -%}
- **{{ capability.name }}**: {{ capability.description }}
{% endfor %}
{% endif %}

{% if episodic_memory -%}
## Context of things the Human said in the past:
{% for memory in episodic_memory -%}
  - {{ memory.content }}{% if memory.timestamp %} ({{ memory.timestamp }}){% endif %}
{% endfor %}
{% endif %}

{% if declarative_memory -%}
## Context of documents containing relevant information:
{% for memory in declarative_memory -%}
  - {{ memory.content }}{% if memory.source %} (extracted from {{ memory.source }}){% endif %}
{% endfor %}
{% endif %}

{% if tools_output -%}
## Context of executed system tools:
{{ tools_output }}
{% endif %}

{% if procedural_memories -%}
## Available procedures:
{% for procedure in procedural_memories -%}
- {{ procedure.name }}: {{ procedure.description }}
{% endfor %}
{% endif %}

{% if domain_knowledge -%}
## Domain Knowledge:
{{ domain_knowledge }}
{% endif %}

{% if constraints -%}
## Constraints:
{% for constraint in constraints -%}
- {{ constraint }}
{% endfor %}
{% endif %}

{% if chat_history -%}
## Recent conversation:
{% for message in chat_history -%}
[{{ message.role | upper }}]
{{ message.content }}

{% endfor -%}
{% endif %}

[USER]
{{ input }}

{% if response_guidelines -%}
## Response Guidelines:
{% for guideline in response_guidelines -%}
- {{ guideline }}
{% endfor %}
{% endif %}

{% if output_format -%}
Please format your response as {{ output_format }}.
{% endif -%}

{% if thinking_required -%}
Please think through this step by step before providing your final answer.
{% endif -%}