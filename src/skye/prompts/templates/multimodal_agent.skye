---
title       = "Multimodal agent"
description = "A multimodal assistant over images, documents and audio; takes the task type, content types, context, examples, tools and memories."
version     = "1.0"
tags        = ["agent", "multimodal"]
---

prompt "multimodal_agent" {
  variables = {
    system_prompt = string("")        "Replaces the default system instructions when not empty"
    task_type     = string("")        "image_analysis, image_qa, document_analysis or multimodal_reasoning"
    content_types = list(string, [])  "Kinds of content provided, e.g. image, text"
    images = list({
      description = string("")  "What the image shows"
      url         = string("")  "Where the image is"
    }, []) "Images"
    documents = list({
      content = string      "Text of the document"
      title   = string("")  "Document title"
    }, []) "Documents"
    audio = list({
      description = string("")  "What the clip contains"
      transcript  = string("")  "Transcript of the clip"
    }, []) "Audio clips"
    context       = string("")        "Additional context"
    examples = list({
      input  = string  "Example request"
      output = string  "Expected answer"
    }, []) "Input/output examples"
    input         = string("")        "The user's message"
    output_format = string("")        "detailed, json, or empty for a plain answer"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are an intelligent multimodal AI assistant that can process and understand text, images, audio, and other media types. You can analyze, describe, and reason about multimodal content."
    }
    when tools {
      text = "## Tools"
      text = "These tools are available to you; use them when they help."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when tool.returns    { text = "  Returns: {{ tool.returns }}" }
      }
    }
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when m.name    { text = "- {{ m.name }}" }
          when m.content { text = "  {{ m.content }}" }
          each step in m.steps { text = "  * {{ step }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }

    when task_type {
      text = "## Task: {{ task_type }}"
      when task_type == "image_analysis"       { text = "Please analyze the provided image(s) and describe what you see." }
      when task_type == "image_qa"             { text = "Please answer questions about the provided image(s)." }
      when task_type == "document_analysis"    { text = "Please analyze the provided document and extract relevant information." }
      when task_type == "multimodal_reasoning" { text = "Please reason about the relationship between the provided text and visual content." }
    }

    when content_types {
      text = "## Content Types Available:"
      each content_type in content_types { text = "- {{ content_type }}" }
    }

    when images {
      text = "## Images:"
      each image in images {
        text = "Image {{ loop.index }}: {{ image.description or 'Provided image' }}"
        when image.url { text = "URL: {{ image.url }}" }
      }
    }

    when documents {
      text = "## Documents:"
      each doc in documents {
        text = "Document {{ loop.index }}: {{ doc.title or 'Provided document' }}"
        text = "Content: {{ doc.content }}"
      }
    }

    when audio {
      text = "## Audio:"
      each audio_item in audio {
        text = "Audio {{ loop.index }}: {{ audio_item.description or 'Provided audio' }}"
        when audio_item.transcript { text = "Transcript: {{ audio_item.transcript }}" }
      }
    }

    when context {
      text = "## Additional Context:"
      text = "{{ context }}"
    }

    when examples {
      text = "## Examples:"
      each example in examples {
        text = "**Input:** {{ example.input }}"
        text = "**Output:** {{ example.output }}"
        text = ""
      }
    }
  }
  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"
    when output_format == "detailed" {
      text = """
        Please provide a detailed analysis including:
        1. **Visual Description**: What you see in any images
        2. **Text Analysis**: Analysis of any text content
        3. **Relationships**: How different content types relate to each other
        4. **Key Insights**: Important observations or conclusions
        5. **Answer**: Direct response to the user's question
        """
    }
    when output_format == "json" {
      text = """
        Please format your response as JSON:
        ```json
        {
            "visual_analysis": "description of visual content",
            "text_analysis": "analysis of text content",
            "key_insights": ["insight 1", "insight 2"],
            "answer": "direct answer to the question",
            "confidence": 0.0
        }
        ```
        """
    }
    when output_format != "detailed" and output_format != "json" {
      text = "Please analyze the provided content and respond to the user's request."
    }
  }
}

/**
 * Example:
 *
 *   builder.render("multimodal_agent", {
 *       "input": "Does the receipt match the photo of the shelf price?",
 *       "task_type": "multimodal_reasoning",
 *       "content_types": ["image", "document"],
 *       "images": [{"description": "Shelf label: olive oil 7.99 EUR", "url": "https://example.com/shelf.jpg"}],
 *       "documents": [{"title": "Receipt", "content": "Olive oil 1L ... 8.49 EUR"}],
 *       "audio": [{"description": "Voice note", "transcript": "I think they overcharged me."}],
 *       "context": "Purchase made on 2026-11-07.",
 *       "examples": [{"input": "Is the label price the same as the receipt?", "output": "No: 7.99 vs 8.49 EUR."}],
 *       "output_format": "json",
 *       "tools": [{"name": "ocr", "description": "Reads the text in an image", "returns": "the text"}],
 *       "semantic_memory": [{"content": "Shelf prices include VAT in Italy", "source": "consumer guide"}],
 *       "history": [
 *           {"role": "user", "content": "I'll send you a photo and a receipt."},
 *           {"role": "assistant", "content": "Ready when you are."},
 *       ],
 *   })
 **/
