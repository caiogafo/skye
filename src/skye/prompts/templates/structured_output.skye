---
title       = "Structured output"
description = "Turns the input into structured data in the format given by the `format` variable (\"json\", the default, \"table\" or \"xml\"), with the fields of the `schema` variable ({name: \"string\"|\"number\"|\"bool\"|\"list\"|\"map\", [type], {nested} or {\"type\": ..., \"description\": ...}}); the output block appends the matching instructions to the last user message. A table takes only scalar fields. Without `schema` (it is optional) the fields are name and value."
version     = "1.0"
tags        = ["structured-output"]
---

prompt "structured_output" {
  variables = {
    system_prompt = string("")        "Replaces the default system instructions when not empty"
    task          = string            "What to extract, e.g. \"List every product with its price\""
    input         = string("")        "The text to extract the data from"
    schema        = map({})           "Output fields, optional (empty: the default fields name and value): {name: \"string\"|\"number\"|\"bool\"|\"list\"|\"map\", [type] or {nested}}"
    format        = string("json")    "\"json\", \"table\" (scalar fields only) or \"xml\""
    instructions  = list(string, [])  "Extra extraction rules"
    examples      = list({
      input  = string  "Example input"
      output = string  "The expected answer for it"
    }, [])             "Worked examples, sent as user/assistant turns"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are a precise data extractor. You turn the input you are given into structured data that follows the requested format exactly."
    }
    text = """
      ## Rules
      - Take every value from the input; never invent, guess or fill in a value that the input does not support.
      - When a value is not in the input, leave it empty instead of making one up: null in JSON (an empty list for a list field), an empty cell in a table, an empty element in XML.
      - Keep the field names and the types exactly as requested; do not add fields that were not asked for.
      - Reply with the structured data only, with no explanation before or after it.
      """
    when instructions {
      each rule in instructions { text = "- {{ rule }}" }
    }
  }

  each example in examples {
    message "user"      { text = "{{ example.input }}" }
    message "assistant" { text = "{{ example.output }}" }
  }

  placeholder "history"

  message "user" {
    text = "## Task"
    text = "{{ task }}"
    when input {
      text = "## Input"
      text = "{{ input }}"
    }
  }

  /**
   * Each field of `schema` is one of:
   *   "string" | "number" | "bool" | "list" | "map"   a type
   *   ["string"] or [{...}]                            a list of that type / of objects (json, xml)
   *   {"city": "string", ...}                          a nested object (json, xml)
   *   {"type": "number", "description": "..."}         a type with a description for the model
   * A table takes only string, number and bool fields; the XML root element is
   * <structured_output>.
   **/
  /**
   * The output block is chosen by `schema`: the fields you pass when you pass them, else a
   * default pair of fields, so the prompt works with no schema at all. Only one of the two
   * `when` blocks holds at a time.
   **/
  # the fields you pass
  when schema { output format { schema = schema } }
  # no schema: a name and a value for each extracted item
  when not schema {
    output format {
      name  = string  "What the extracted item is"
      value = string  "Its value, as written in the input"
    }
  }
}

/**
 * Example:
 *
 *   builder.render("structured_output", {
 *       "task": "List every product with its price",
 *       "input": "Notebooks cost 4.50 EUR and are in stock; pens cost 1.20 EUR, sold out.",
 *       "format": "table",
 *       "schema": {
 *           "name": {"type": "string", "description": "Product name"},
 *           "price": {"type": "number", "description": "Unit price in EUR"},
 *           "in_stock": "bool",
 *       },
 *       "instructions": ["Write prices without the currency symbol."],
 *       "examples": [
 *           {
 *               "input": "Pens, 1.20 EUR each, in stock.",
 *               "output": "| name | price | in_stock |\n| --- | --- | --- |\n| Pens | 1.2 | true |",
 *           },
 *       ],
 *   })
 *
 * Without "schema" the answer has the default fields, name and value:
 *
 *   builder.render("structured_output", {"task": "List every product", "input": "Pens 1.20 EUR, ink 3 EUR."})
 **/
