---
title       = "Code agent"
description = "A code assistant for generation, review, debugging, explanation and refactoring; takes the task type, language, code context, requirements, error message, tools and memories."
version     = "1.0"
tags        = ["agent", "code"]
---

prompt "code_agent" {
  variables = {
    system_prompt        = string("")        "Replaces the default system instructions when not empty"
    task_type            = string("")        "code_generation, code_review, debugging, code_explanation or refactoring"
    programming_language = string("")        "Language of the code, also used as the code-fence tag"
    code_context         = string("")        "Existing code to work on"
    requirements         = list(string, [])  "What the code must do"
    constraints          = list(string, [])  "Limits to respect"
    error_message        = string("")        "Error output to debug"
    examples             = list({
      input    = string      "Example input"
      output   = string      "Expected output"
      language = string("")  "Code-fence tag of both blocks"
    }, []) "Input/output examples"
    input                = string("")        "The user's message"
    output_format        = string("")        "detailed, json, or empty for code plus a short explanation"
    code_style           = list(string, [])  "Code style guidelines"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt { text = "You are an intelligent code assistant that can help with programming tasks, code analysis, debugging, and software development. You understand multiple programming languages and can provide accurate, helpful code solutions." }
    when task_type {
      text = "## Task: {{ task_type }}"
      when task_type == "code_generation"  { text = "Please generate code based on the requirements." }
      when task_type == "code_review"      { text = "Please review the provided code and suggest improvements." }
      when task_type == "debugging"        { text = "Please help debug the provided code and identify issues." }
      when task_type == "code_explanation" { text = "Please explain how the provided code works." }
      when task_type == "refactoring"      { text = "Please refactor the provided code to improve its quality." }
    }
    when programming_language { text = "## Programming Language: {{ programming_language }}" }
    when code_context {
      text = "## Code Context:"
      text = "```{{ programming_language }}"
      text = "{{ code_context }}"
      text = "```"
    }
    when requirements {
      text = "## Requirements:"
      each requirement in requirements { text = "- {{ requirement }}" }
    }
    when constraints {
      text = "## Constraints:"
      each constraint in constraints { text = "- {{ constraint }}" }
    }
    when error_message {
      text = "## Error Message:"
      text = "```"
      text = "{{ error_message }}"
      text = "```"
    }
    when examples {
      text = "## Examples:"
      each example in examples {
        text = "**Input:**"
        text = "```{{ example.language }}"
        text = "{{ example.input }}"
        text = "```"
        text = "**Output:**"
        text = "```{{ example.language }}"
        text = "{{ example.output }}"
        text = "```"
      }
    }
    when tools {
      text = "## Tools"
      text = "You can call these tools:"
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when tool.returns    { text = "  Returns: {{ tool.returns }}" }
      }
    }

    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when m.name    { text = "- {{ m.name }}" }
          when m.content { text = "  {{ m.content }}" }
          each step in m.steps { text = "  * {{ step }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }
  }

  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"
    when output_format == "detailed" {
      text = "Please provide:"
      text = "1. **Code Solution**: The complete code solution"
      text = "2. **Explanation**: How the code works"
      text = "3. **Key Features**: Important aspects of the implementation"
      text = "4. **Usage Example**: How to use the code"
      text = "5. **Testing**: Suggestions for testing the code"
    }
    when output_format == "json" {
      text = "Please format your response as JSON:"
      text = "```json"
      text = "{"
      text = "    \"code\": \"the complete code solution\","
      text = "    \"explanation\": \"how the code works\","
      text = "    \"language\": \"programming language used\","
      text = "    \"dependencies\": [\"dependency1\", \"dependency2\"],"
      text = "    \"usage_example\": \"example of how to use the code\","
      text = "    \"test_cases\": [\"test case 1\", \"test case 2\"]"
      text = "}"
      text = "```"
    }
    when output_format != "detailed" and output_format != "json" {
      text = "Please provide the code solution with appropriate explanation."
    }
    when code_style {
      text = "## Code Style Guidelines:"
      each guideline in code_style { text = "- {{ guideline }}" }
    }
  }
}

/**
 * Example:
 *
 *   builder.render("code_agent", {
 *       "input": "Why does this function crash on an empty list?",
 *       "task_type": "debugging",
 *       "programming_language": "python",
 *       "code_context": "def average(xs):\n    return sum(xs) / len(xs)",
 *       "requirements": ["Return 0.0 for an empty list"],
 *       "constraints": ["No third-party packages"],
 *       "error_message": "ZeroDivisionError: division by zero",
 *       "examples": [
 *           {"input": "average([2, 4])", "output": "3.0", "language": "python"},
 *       ],
 *       "output_format": "detailed",
 *       "code_style": ["PEP 8", "type hints"],
 *       "tools": [
 *           {
 *               "name": "run_tests",
 *               "description": "Runs the project's unit tests",
 *               "parameters": {"path": "test file or directory"},
 *               "returns": "the pytest summary",
 *           },
 *       ],
 *       "episodic_memory": [{"content": "The user fixed a similar bug in median()", "timestamp": "2026-11-02"}],
 *       "semantic_memory": [{"content": "The project targets Python 3.11", "source": "pyproject.toml"}],
 *       "procedural_memory": [{"name": "Fix a crash", "steps": ["Reproduce it", "Add a test", "Fix the code"]}],
 *       "persona_memory": [{"content": "Prefers short explanations"}],
 *       "working_memory": [{"content": "The failing test is test_average_empty"}],
 *       "history": [
 *           {"role": "user", "content": "I have a bug in my stats module."},
 *           {"role": "assistant", "content": "Share the function and the error, please."},
 *       ],
 *   })
 **/
