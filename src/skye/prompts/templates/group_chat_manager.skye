---
title       = "Group chat manager"
description = "Picks who speaks next in a conversation shared by several agents, from their triggers and @mentions, as JSON."
version     = "1.0"
tags        = ["agent", "group-chat"]
---

prompt "group_chat_manager" {
  variables = {
    system_prompt     = string("")        "Replaces the default system instructions when not empty"
    goal              = string            "What the group is trying to achieve"
    participants      = list({
      name     = string            "Agent name"
      role     = string("")        "What the agent does"
      triggers = list(string, [])  "Topics the agent speaks on"
    }, [])                         "Agents in the conversation"
    transcript        = list({
      speaker = string             "Who spoke"
      content = string             "What they said"
    }, [])                         "Conversation so far"
    last_message      = string("")        "The message to react to; when empty, the last line of the transcript"
    max_speakers      = number(1)         "Maximum number of agents chosen to speak next"
    end_token         = string("[DONE]")  "Marker that ends the conversation once the goal is reached"
    tools             = list({
      name        = string         "Tool name"
      description = string         "What the tool does"
      parameters  = map({})        "Arguments: name to type or description"
      returns     = string("")     "What the tool returns"
    }, [])                         "Tools the agent may call"
    episodic_memory   = list({
      content   = string           "What happened"
      timestamp = string("")       "When it happened"
      source    = string("")       "Where it comes from"
    }, [])                         "Past events"
    semantic_memory   = list({
      content = string             "The fact"
      source  = string("")         "Where it comes from"
    }, [])                         "Known facts"
    procedural_memory = list({
      name    = string("")         "Procedure name"
      content = string("")         "How to do it, as text"
      steps   = list(string, [])   "How to do it, as steps"
    }, [])                         "Procedures that worked"
    persona_memory    = list({
      content = string             "What is known about the user or the agent"
      source  = string("")         "Where it comes from"
    }, [])                         "Who the user and the agent are"
    working_memory    = list({
      content = string             "The note"
    }, [])                         "Notes for the current task"
    constraints       = list(string, [])  "Rules to respect"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You moderate a conversation shared by several agents. You do not take part in it: after each message you decide who should speak next, so that the right agents contribute and the others stay quiet."
    }

    text = "## Goal of the group"
    text = "{{ goal }}"

    text = "## Participants"
    when participants {
      each p in participants {
        when "role" in p and p.role       { text = "- @{{ p.name }}: {{ p.role }}" }
        when not ("role" in p and p.role) { text = "- @{{ p.name }}" }
        when "triggers" in p and p.triggers { text = "  Speaks on: {{ p.triggers | join(', ') }}" }
      }
    }
    when not participants { text = "(no participants were listed; end the conversation)" }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You may call these tools when they help; when a tool would not help, answer without it."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when "timestamp" in m and m.timestamp       { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not ("timestamp" in m and m.timestamp) { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when "name" in m and m.name { text = "- {{ m.name }}" }
          when "content" in m and m.content { text = "  {{ m.content }}" }
          when "steps" in m and m.steps {
            each step in m.steps { text = "  * {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when "name" in m and m.name       { text = "- {{ m.name }}: {{ m.content }}" }
          when not ("name" in m and m.name) { text = "- {{ m.content }}" }
        }
      }
    }
    when constraints {
      text = "## Constraints"
      each constraint in constraints { text = "- {{ constraint }}" }
    }

    text = """
      ## How to choose
      - Anyone mentioned as @name in the last message is chosen first.
      - Then choose the participants whose topics match the last message.
      - If nobody matches, choose the participant whose role best moves the group toward its goal.
      - Do not choose the author of the last message unless they were asked something directly.
      - Use only the names listed above, and choose at most {{ max_speakers }}.
      - End the conversation when the goal has been reached, or when the last message ends with {{ end_token }}.

      ## Answer format
      Reply with one JSON object and nothing else, in one of these two shapes:
      {"next_speakers": ["<name>"], "reason": "<why these speakers>"}
      {"next_speakers": [], "end": true, "reason": "<why the conversation is over>"}
      """
  }

  placeholder "history"

  message "user" {
    text = "## Conversation so far"
    when transcript {
      each entry in transcript { text = "{{ entry.speaker }}: {{ entry.content }}" }
    }
    when not transcript { text = "(nobody has spoken yet)" }
    when last_message {
      text = "## Last message"
      text = "{{ last_message }}"
    }
    when not last_message { text = "The last message is the last line of the conversation above." }
    text = "Who speaks next?"
  }
}

/**
 * Example:
 *
 *   builder.render("group_chat_manager", {
 *       "goal": "Agree on a launch date for the new app.",
 *       "participants": [
 *           {"name": "planner", "role": "Keeps the schedule", "triggers": ["dates", "deadlines"]},
 *           {"name": "designer", "role": "Designs the screens", "triggers": ["screens", "layout"]},
 *           {"name": "tester", "triggers": ["testing", "bugs"]},
 *       ],
 *       "transcript": [
 *           {"speaker": "user", "content": "We need a launch date for the new app."},
 *           {"speaker": "planner", "content": "@designer, when can the screens be ready?"},
 *           {"speaker": "designer", "content": "The screens can be ready by 20 November."},
 *       ],
 *       "max_speakers": 2,
 *   })
 **/
