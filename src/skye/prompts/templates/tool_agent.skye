---
title       = "Tool agent"
description = "An agent that picks one of its tools (or none) for the user's request and answers with a JSON action; takes the tools, examples, history and memories."
version     = "1.0"
tags        = ["agent", "tools", "json"]
---

prompt "tool_agent" {
  variables = {
    system_prompt = string("")  "Replaces the default system instructions when not empty"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    examples = list({
      question     = string      "Example request"
      action       = string      "Tool chosen, or no_action"
      action_input = string("")  "Input given to it"
    }, []) "Worked examples"
    input         = string("")  "The user's message"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are an intelligent AI assistant that can use tools to help answer questions and complete tasks. You have access to various tools and should use them when appropriate."
    }
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when m.name    { text = "- {{ m.name }}" }
          when m.content { text = "  {{ m.content }}" }
          each step in m.steps { text = "  * {{ step }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }

    text = "Create a JSON with the correct \"action\" and \"action_input\" to help the Human."
    text = "You can use one of these actions:"
    each tool in tools { text = "- \"{{ tool.name }}\": {{ tool.description }}" }
    text = "- \"no_action\": Use this action if no relevant action is available. Input is always null."

    text = "## The JSON must have the following structure:"
    text = "```json"
    text = "{"
    when tools {
      text = "    \"action\": // str - The name of the action to take, should be one of [\"{{ tools | map('name') | join('\", \"') }}\", \"no_action\"]"
    }
    when not tools {
      text = "    \"action\": // str - The name of the action to take, should be one of [, \"no_action\"]"
    }
    text = "    \"action_input\": // str or null - The input to the action according to its description"
    text = "}"
    text = "```"

    when examples {
      text = "## Here are some examples:"
      each example in examples {
        text = """
          Question: {{ example.question }}
          ```json
          {
              "action": "{{ example.action }}",
              "action_input": "{{ example.action_input }}"
          }
          ```
          """
      }
      text = """
        Question: I have no questions
        ```json
        {
            "action": "no_action",
            "action_input": null
        }
        ```
        """
    }

  }
  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"
    text = "Please respond with the appropriate JSON action."
  }
}

/**
 * Example:
 *
 *   builder.render("tool_agent", {
 *       "input": "What's the weather in Rome tomorrow?",
 *       "tools": [
 *           {"name": "weather", "description": "Gives the forecast for a city", "parameters": {"city": "city name"}},
 *           {"name": "calculator", "description": "Evaluates an arithmetic expression"},
 *       ],
 *       "examples": [
 *           {"question": "How much is 12 * 7?", "action": "calculator", "action_input": "12 * 7"},
 *       ],
 *       "semantic_memory": [{"content": "The user lives in Rome", "source": "profile"}],
 *       "working_memory": [{"content": "The user plans a picnic"}],
 *       "history": [
 *           {"role": "user", "content": "Hi!"},
 *           {"role": "assistant", "content": "Hello, how can I help?"},
 *       ],
 *   })
 **/
