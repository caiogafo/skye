---
title       = "Reasoning agent"
description = "A step-by-step reasoning assistant; takes the reasoning type, context, constraints, examples, output layout, tools and memories."
version     = "1.0"
tags        = ["agent", "reasoning"]
---

prompt "reasoning_agent" {
  variables = {
    system_prompt  = string("")        "Replaces the default system instructions when not empty"
    reasoning_type = string("")        "chain_of_thought, tree_of_thought, analytical or creative"
    context        = string("")        "Background for the problem"
    constraints    = list(string, [])  "Limits to respect"
    examples = list({
      problem   = string      "Example problem"
      reasoning = string("")  "How it was reasoned through"
      solution  = string      "The solution reached"
    }, []) "Worked examples"
    input          = string("")        "The user's message"
    output_format  = string("")        "structured, json, or empty for a plain explanation"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are an intelligent reasoning assistant that can break down complex problems, analyze information, and provide step-by-step solutions. You think through problems methodically and explain your reasoning clearly."
    }

    when reasoning_type {
      text = "## Reasoning Type: {{ reasoning_type }}"
      when reasoning_type == "chain_of_thought" { text = "Please think through this step by step, showing your reasoning process." }
      when reasoning_type == "tree_of_thought"  { text = "Please explore multiple reasoning paths and evaluate the best approach." }
      when reasoning_type == "analytical"       { text = "Please provide a structured analytical breakdown of the problem." }
      when reasoning_type == "creative"         { text = "Please approach this problem creatively, considering unconventional solutions." }
    }

    when context {
      text = "## Context:"
      text = "{{ context }}"
    }

    when constraints {
      text = "## Constraints:"
      each constraint in constraints { text = "- {{ constraint }}" }
    }

    when examples {
      text = "## Examples of similar reasoning:"
      each example in examples {
        text = "**Problem:** {{ example.problem }}"
        text = "**Reasoning:** {{ example.reasoning }}"
        text = "**Solution:** {{ example.solution }}"
      }
    }
    when tools {
      text = "## Tools"
      text = "You can call these tools:"
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when tool.returns    { text = "  Returns: {{ tool.returns }}" }
      }
    }
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when m.name    { text = "- {{ m.name }}" }
          when m.content { text = "  {{ m.content }}" }
          each step in m.steps { text = "  * {{ step }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }

  }
  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"

    when output_format == "structured" {
      text = """
        Please structure your response as follows:
        1. **Problem Analysis**: Break down the problem
        2. **Key Considerations**: Important factors to consider
        3. **Reasoning Steps**: Step-by-step thought process
        4. **Solution**: Your recommended approach
        5. **Confidence**: How confident you are in this solution (1-10)
        """
    }
    when output_format == "json" {
      text = """
        Please format your response as JSON:
        ```json
        {
            "problem_analysis": "breakdown of the problem",
            "reasoning_steps": ["step 1", "step 2", "step 3"],
            "solution": "your recommended solution",
            "confidence": 0.0,
            "alternative_approaches": ["approach 1", "approach 2"]
        }
        ```
        """
    }
    when output_format != "structured" and output_format != "json" {
      text = "Please think through this carefully and explain your reasoning."
    }
  }
}

/**
 * Example:
 *
 *   builder.render("reasoning_agent", {
 *       "input": "Should we cache the product catalogue or query it every time?",
 *       "reasoning_type": "analytical",
 *       "context": "The catalogue has 20,000 items and changes twice a day.",
 *       "constraints": ["At most 512 MB of memory", "Prices must be up to date within 10 minutes"],
 *       "examples": [
 *           {"problem": "Cache user sessions?", "reasoning": "Read often, small, short-lived.", "solution": "Yes, in Redis with a TTL."},
 *       ],
 *       "output_format": "structured",
 *       "tools": [{"name": "benchmark", "description": "Measures query latency", "returns": "milliseconds"}],
 *       "episodic_memory": [{"content": "Last month the database was slow at peak time", "timestamp": "2026-10-15"}],
 *       "procedural_memory": [{"name": "Decide on caching", "content": "Compare read rate, size and staleness tolerance"}],
 *       "history": [
 *           {"role": "user", "content": "I need help with an architecture choice."},
 *           {"role": "assistant", "content": "Sure, tell me about it."},
 *       ],
 *   })
 **/
