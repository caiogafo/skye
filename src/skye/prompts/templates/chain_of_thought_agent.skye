---
title       = "Chain-of-thought agent"
description = "Reasons through the task in numbered steps, then gives a clearly marked final answer; optional worked examples."
version     = "1.0"
tags        = ["agent", "reasoning"]
---

prompt "chain_of_thought_agent" {
  variables = {
    system_prompt     = string("")  "Replaces the default system instructions when not empty"
    task              = string      "The task to accomplish"
    examples          = list({
      question  = string          "The question"
      reasoning = string("")      "The worked reasoning"
      answer    = string          "The final answer"
    }, [])                        "Worked examples, sent as user/assistant turns"
    show_reasoning    = bool(true)  "Write the numbered steps (true) or only the final answer (false)"
    tools             = list({
      name        = string        "Tool name"
      description = string        "What the tool does"
      parameters  = map({})       "Arguments: name to type or description"
      returns     = string("")    "What the tool returns"
    }, [])                        "Tools the agent may call"
    episodic_memory   = list({
      content   = string          "What happened"
      timestamp = string("")      "When it happened"
      source    = string("")      "Where it comes from"
    }, [])                        "Past events"
    semantic_memory   = list({
      content = string            "The fact"
      source  = string("")        "Where it comes from"
    }, [])                        "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, [])                        "Procedures that worked"
    persona_memory    = list({
      content = string            "What is known about the user or the agent"
      source  = string("")        "Where it comes from"
    }, [])                        "Who the user and the agent are"
    working_memory    = list({
      content = string            "The note"
    }, [])                        "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are a careful problem solver. Before answering, you work the problem out one small step at a time, so that every conclusion rests on something already established."
    }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You may call these tools when they help; when a tool would not help, answer without it."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when "timestamp" in m and m.timestamp       { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not ("timestamp" in m and m.timestamp) { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when "name" in m and m.name { text = "- {{ m.name }}" }
          when "content" in m and m.content { text = "  {{ m.content }}" }
          when "steps" in m and m.steps {
            each step in m.steps { text = "  * {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when "name" in m and m.name       { text = "- {{ m.name }}: {{ m.content }}" }
          when not ("name" in m and m.name) { text = "- {{ m.content }}" }
        }
      }
    }

    when show_reasoning {
      text = """
        ## How to answer
        - Break the problem into small steps and number them: Step 1, Step 2, and so on.
        - Each step does one thing: state a fact from the task, apply a rule, compute a value, or check an earlier result.
        - When a step reveals a mistake, say so and correct it in the next step instead of carrying on.
        - Finish with one line that starts with "Final answer:" and holds only the answer.

        ## Answer format
        Step 1: <first step>
        Step 2: <next step>
        ...
        Final answer: <the answer>
        """
    }
    when not show_reasoning {
      text = """
        ## How to answer
        Work through the problem step by step in your head, but do not write the steps.
        Reply with a single line that starts with "Final answer:" and holds only the answer.
        """
    }
  }

  each example in examples {
    message "user" { text = "{{ example.question }}" }
    message "assistant" {
      when show_reasoning { text = "{{ example.reasoning }}" }
      text = "Final answer: {{ example.answer }}"
    }
  }

  placeholder "history"

  message "user" {
    text = "{{ task }}"
  }
}

/**
 * Example:
 *
 *   builder.render("chain_of_thought_agent", {
 *       "task": "A train leaves at 9:40 and arrives at 12:15. How long is the trip?",
 *       "examples": [
 *           {
 *               "question": "A film starts at 20:30 and lasts 1 h 50 min. When does it end?",
 *               "reasoning": "1. 20:30 + 1 h = 21:30.\n2. 21:30 + 50 min = 22:20.",
 *               "answer": "22:20",
 *           },
 *       ],
 *       "tools": [
 *           {
 *               "name": "calculator",
 *               "description": "Evaluates an arithmetic expression.",
 *               "parameters": {"expression": "The expression, e.g. 3 * 4.5"},
 *               "returns": "The result as a number",
 *           },
 *       ],
 *       "working_memory": [{"content": "Times are in the 24-hour format."}],
 *   })
 **/
