---
title       = "Form agent"
description = "Guides the user through a structured form field by field; takes the form fields, current field, collected data, validation errors, progress, tools and memories."
version     = "1.0"
tags        = ["agent", "form"]
---

prompt "form_agent" {
  variables = {
    system_prompt    = string("")  "Replaces the default system instructions when not empty"
    form_description = string("")  "What the form is for"
    form_fields = list({
      name        = string            "Field name"
      description = string("")        "What to ask for"
      required    = bool(false)       "The field must be filled"
      type        = string("")        "Value type, e.g. email or date"
      options     = list(string, [])  "Allowed values"
      validation  = string("")        "Validation rule, as text"
    }, []) "Fields of the form"
    # Every field is optional so that an empty map means "no current field".
    current_field = map({
      name        = string("")        "Field name"
      description = string("")        "What to ask for"
      examples    = list(string, [])  "Example values"
    }, {}) "Field being collected"
    collected_data    = map({})           "Values collected so far: field name to value"
    validation_errors = list(string, [])  "Validation errors to report"
    form_progress = map({
      completed = number(0)  "Fields completed"
      total     = number(0)  "Fields in the form"
    }, {}) "Progress counts"
    input             = string("")        "The user's message"
    form_complete     = bool(false)       "All fields collected: show the summary and ask to submit"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are an intelligent form assistant that helps users complete structured forms and data collection tasks. You guide users through form completion step by step."
    }
    when tools {
      text = "## Tools"
      text = "These tools are available to you; use them when they help."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when tool.returns    { text = "  Returns: {{ tool.returns }}" }
      }
    }
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when m.name    { text = "- {{ m.name }}" }
          when m.content { text = "  {{ m.content }}" }
          each step in m.steps { text = "  * {{ step }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }

    when form_description { text = "## Form: {{ form_description }}" }

    when form_fields {
      text = "## Required Fields:"
      each field in form_fields {
        when field.required     { text = "- **{{ field.name }}** (required): {{ field.description }}" }
        when not field.required { text = "- **{{ field.name }}**: {{ field.description }}" }
        when field.type       { text = "  Type: {{ field.type }}" }
        when field.options    { text = "  Options: {{ field.options | join(', ') }}" }
        when field.validation { text = "  Validation: {{ field.validation }}" }
      }
    }

    when current_field.name {
      text = "## Current Field"
      text = "We are currently collecting: **{{ current_field.name }}**"
      text = "{{ current_field.description }}"
      when current_field.examples { text = "Examples: {{ current_field.examples | join(', ') }}" }
    }

    when collected_data {
      text = "## Data Collected So Far:"
      each entry in collected_data { text = "- {{ entry.key }}: {{ entry.value }}" }
    }

    when validation_errors {
      text = "## Validation Errors:"
      each error in validation_errors { text = "- {{ error }}" }
    }

    when form_progress.total { text = "## Progress: {{ form_progress.completed }}/{{ form_progress.total }} fields completed" }
  }
  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"
    when form_complete {
      text = "## Form Complete!"
      text = "All required fields have been collected. Here's the summary:"
      each entry in collected_data { text = "- {{ entry.key }}: {{ entry.value }}" }
      text = "Would you like to submit this form or make any changes?"
    }
    when not form_complete and current_field.name     { text = "Please provide the value for: **{{ current_field.name }}**" }
    when not form_complete and not current_field.name { text = "Let's start filling out the form. I'll guide you through each field." }
  }
}

/**
 * Example:
 *
 *   builder.render("form_agent", {
 *       "input": "My email is ada@example.com",
 *       "form_description": "Newsletter sign-up",
 *       "form_fields": [
 *           {"name": "name", "description": "Full name", "required": True},
 *           {"name": "email", "description": "Email address", "required": True, "type": "email", "validation": "must contain @"},
 *           {"name": "topics", "description": "Topics of interest", "options": ["tech", "science", "art"]},
 *       ],
 *       "current_field": {"name": "email", "description": "Your email address", "examples": ["ada@example.com"]},
 *       "collected_data": {"name": "Ada Lovelace"},
 *       "validation_errors": [],
 *       "form_progress": {"completed": 1, "total": 3},
 *       "form_complete": False,
 *       "tools": [{"name": "check_email", "description": "Checks that an email address exists", "returns": "true or false"}],
 *       "persona_memory": [{"content": "Signed up to another list last year", "source": "CRM"}],
 *       "working_memory": [{"content": "Ask for topics last"}],
 *       "history": [
 *           {"role": "assistant", "content": "What is your full name?"},
 *           {"role": "user", "content": "Ada Lovelace"},
 *       ],
 *   })
 **/
