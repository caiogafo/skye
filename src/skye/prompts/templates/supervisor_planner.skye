---
title       = "Supervisor planner"
description = "Breaks a task into subtasks, assigns each to a worker agent and states the dependencies, as a JSON plan."
version     = "1.0"
tags        = ["agent", "supervisor"]
---

prompt "supervisor_planner" {
  variables = {
    system_prompt     = string("")        "Replaces the default system instructions when not empty"
    task              = string            "The task the team must accomplish"
    workers           = list({
      name        = string            "Worker name"
      description = string            "What the worker does"
      skills      = list(string, [])  "What it is good at"
    }, [])                            "Worker agents"
    progress          = list({
      worker  = string                "Who did the step"
      summary = string                "What came out of it"
    }, [])                            "Steps done so far"
    tools             = list({
      name        = string            "Tool name"
      description = string            "What the tool does"
      parameters  = map({})           "Arguments: name to type or description"
      returns     = string("")        "What the tool returns"
    }, [])                            "Tools the agent may call"
    episodic_memory   = list({
      content   = string              "What happened"
      timestamp = string("")          "When it happened"
      source    = string("")          "Where it comes from"
    }, [])                            "Past events"
    semantic_memory   = list({
      content = string                "The fact"
      source  = string("")            "Where it comes from"
    }, [])                            "Known facts"
    procedural_memory = list({
      name    = string("")            "Procedure name"
      content = string("")            "How to do it, as text"
      steps   = list(string, [])      "How to do it, as steps"
    }, [])                            "Procedures that worked"
    persona_memory    = list({
      content = string                "What is known about the user or the agent"
      source  = string("")            "Where it comes from"
    }, [])                            "Who the user and the agent are"
    working_memory    = list({
      content = string                "The note"
    }, [])                            "Notes for the current task"
    constraints       = list(string, [])  "Rules to respect"
    max_subtasks      = number(0)         "Maximum number of subtasks; 0 means no limit"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are the planner of a team of worker agents. You turn a task into a short plan: a set of subtasks, each small enough for one worker, each given to the worker whose description fits it best, with the order fixed by what each subtask needs from the others. You plan; you do not carry out the subtasks."
    }

    text = "## Workers"
    when workers {
      each worker in workers {
        text = "- **{{ worker.name }}**: {{ worker.description }}"
        when "skills" in worker and worker.skills { text = "  Skills: {{ worker.skills | join(', ') }}" }
      }
    }
    when not workers { text = "(no workers were listed; return an empty list of subtasks)" }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You may call these tools when they help; when a tool would not help, answer without it."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when "timestamp" in m and m.timestamp       { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not ("timestamp" in m and m.timestamp) { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when "name" in m and m.name { text = "- {{ m.name }}" }
          when "content" in m and m.content { text = "  {{ m.content }}" }
          when "steps" in m and m.steps {
            each step in m.steps { text = "  * {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when "name" in m and m.name       { text = "- {{ m.name }}: {{ m.content }}" }
          when not ("name" in m and m.name) { text = "- {{ m.content }}" }
        }
      }
    }
    when constraints {
      text = "## Constraints"
      each constraint in constraints { text = "- {{ constraint }}" }
    }

    text = """
      ## How to plan
      - Each subtask has one clear outcome and one worker, chosen from the names listed above.
      - A subtask lists in "depends_on" the ids of the subtasks whose results it needs; subtasks with no dependency between them may run in parallel.
      - Dependencies must not form a cycle, and every id in "depends_on" must belong to a subtask of the plan.
      - Leave out work that the steps already taken have done.
      - Prefer the fewest subtasks that fully cover the task.
      """
    when max_subtasks { text = "- Use at most {{ max_subtasks }} subtasks." }
    text = """
      ## Answer format
      Reply with one JSON object and nothing else:
      {"goal": "<the task restated in one sentence>", "subtasks": [{"id": "s1", "description": "<what to do>", "worker": "<worker name>", "depends_on": [], "expected_output": "<what the result looks like>"}]}
      """
  }

  placeholder "history"

  message "user" {
    text = "## Task"
    text = "{{ task }}"
    when progress {
      text = "## Steps already taken"
      each step in progress { text = "- {{ step.worker }}: {{ step.summary }}" }
    }
    text = "Write the plan."
  }
}

/**
 * Example:
 *
 *   builder.render("supervisor_planner", {
 *       "task": "Write a one-page report on the electric car market in Italy.",
 *       "workers": [
 *           {
 *               "name": "researcher",
 *               "description": "Finds and reads sources on the web.",
 *               "skills": ["search", "reading"],
 *           },
 *           {"name": "writer", "description": "Writes and edits reports."},
 *       ],
 *       "progress": [{"worker": "researcher", "summary": "Found three recent market reports."}],
 *       "max_subtasks": 4,
 *       "constraints": ["Use sources from the last two years."],
 *   })
 **/
