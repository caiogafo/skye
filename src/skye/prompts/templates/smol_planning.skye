---
title       = "Planning step of a smolagents-style agent"
description = "A survey of the facts and a step-by-step plan, either at the start (\"initial\") or to revise the plan mid-run (\"update\")."
version     = "1.0"
tags        = ["agent", "smolagents", "planning"]
---

prompt "smol_planning" {
  variables = {
    system_prompt     = string("")         "Replaces the default system instructions when not empty"
    task              = string             "The task to plan for"
    phase             = string("initial")  "\"initial\" to write a first plan, \"update\" to revise it"
    tools             = list({
      name        = string        "Tool name"
      description = string        "What the tool does"
      parameters  = map({})       "Arguments: name to type or description"
      returns     = string("")    "What the tool returns"
    }, [])                        "Tools the agent may call"
    managed_agents    = list({
      name        = string        "Agent name, called like a function"
      description = string        "What the agent does"
    }, [])                        "Agents the agent can delegate to"
    previous_plan     = string("")         "The plan written before, shown when phase is \"update\""
    remaining_steps   = number(0)          "Steps the agent has left, for phase \"update\"; 0 means no limit"
    episodic_memory   = list({
      content   = string          "What happened"
      timestamp = string("")      "When it happened"
      source    = string("")      "Where it comes from"
    }, [])                        "Past events"
    semantic_memory   = list({
      content = string            "The fact"
      source  = string("")        "Where it comes from"
    }, [])                        "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, [])                        "Procedures that worked"
    persona_memory    = list({
      content = string            "What is known about the user or the agent"
      source  = string("")        "Where it comes from"
    }, [])                        "Who the user and the agent are"
    working_memory    = list({
      content = string            "The note"
    }, [])                        "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are the planner of an agent. You do not solve the task yourself: you take stock of what is known and write the steps the agent will carry out, with the tools it has, to reach the answer."
    }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "The agent can use these tools, and finishes the task with `final_answer`:"
      each tool in tools {
        text = "- `{{ tool.name }}`: {{ tool.description }}"
        when "parameters" in tool and tool.parameters {
          text = "    Arguments:"
          each param in tool.parameters { text = "    - `{{ param.key }}`: {{ param.value }}" }
        }
        when "returns" in tool and tool.returns { text = "    Returns: {{ tool.returns }}" }
      }
    }
    when not tools {
      text = "The agent has no tools apart from `final_answer`, so the plan must rely on reasoning and on what is already known."
    }

    when managed_agents {
      text = "## Team members"
      text = "The agent can hand sub-tasks to these agents, giving each a complete description of what is needed:"
      each agent in managed_agents { text = "- `{{ agent.name }}`: {{ agent.description }}" }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when persona_memory or semantic_memory or episodic_memory or procedural_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona (who the user and you are, and their preferences)"
        each m in persona_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
      when episodic_memory {
        text = "### Past interactions"
        each m in episodic_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
      when procedural_memory {
        text = "### Procedures you know"
        each m in procedural_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if ('name' in m and m.name) and ('content' in m and m.content) }}{{ m.content if 'content' in m and m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
          when "steps" in m and m.steps {
            each step in m.steps { text = "    - {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Working notes for this task"
        each m in working_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
    }
  }

  placeholder "history"

  message "user" {
    when phase != "update" {
      text = "Here is the task to plan for:"
      text = "{{ task }}"
      text = """
        Write two parts, using exactly these headings.

        ## 1. Facts
        ### 1.1 Stated in the task
        The names, figures, dates and conditions the task gives you. If there are none, say so.
        ### 1.2 To find out
        What is missing and where it can be looked up (which tool or source).
        ### 1.3 To work out
        What has to be computed or deduced from the facts above.
        Do not guess: list only what you know or what must be found.

        ## 2. Plan
        A short numbered list of high-level steps that leads from the facts to the answer. Each step should be one clear action; do not write tool calls or code. The last step gives the result to final_answer.
        Write <end_plan> on its own line after the last step and stop there.
        """
    }
    when phase == "update" {
      text = "The task is still open:"
      text = "{{ task }}"
      text = "The messages above show what the agent has done so far: its reasoning, its calls and what came back."
      when previous_plan {
        text = "## Previous plan"
        text = "{{ previous_plan }}"
      }
      text = """
        Revise the work in two parts, using exactly these headings.

        ## 1. Updated facts
        ### 1.1 Stated in the task
        ### 1.2 Learned so far
        ### 1.3 Still to find out
        ### 1.4 Still to work out
        Keep what is confirmed, drop what turned out to be wrong.

        ## 2. New plan
        A short numbered list of the steps still needed, building on what has worked and avoiding what has failed. Do not write tool calls or code. The last step gives the result to final_answer.
        Write <end_plan> on its own line after the last step and stop there.
        """
      when remaining_steps { text = "The agent has at most {{ remaining_steps }} steps left, so keep the plan within that budget." }
    }
  }
}

/**
 * Example:
 *
 *   builder.render("smol_planning", {
 *       "task": "Find the cheapest train from Milan to Rome next Friday.",
 *       "phase": "update",
 *       "previous_plan": "1. Search the train operators' sites.\n2. Compare the prices.",
 *       "remaining_steps": 4,
 *       "tools": [
 *           {
 *               "name": "web_search",
 *               "description": "Searches the web and returns the top results.",
 *               "parameters": {"query": "What to search for"},
 *               "returns": "A list of titles and links",
 *           },
 *       ],
 *       "managed_agents": [{"name": "researcher", "description": "Searches the web and reports what it finds."}],
 *       "procedural_memory": [{"name": "price_check", "steps": ["search the official site", "note the price with its date"]}],
 *   })
 **/
