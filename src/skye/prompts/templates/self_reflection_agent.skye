---
title       = "Self-reflection agent (Reflexion style)"
description = "\"act\" answers the task, \"reflect\" critiques an earlier attempt and draws lessons, \"revise\" answers again using those lessons."
version     = "1.0"
tags        = ["agent", "reasoning"]
---

prompt "self_reflection_agent" {
  variables = {
    system_prompt     = string("")        "Replaces the default system instructions when not empty"
    task              = string            "The task to accomplish"
    phase             = string("act")     "\"act\", \"reflect\" or \"revise\""
    previous_attempt  = string("")        "The earlier answer to reflect on or revise"
    feedback          = string("")        "Feedback on the previous attempt, for phase \"reflect\""
    test_results      = list(string, [])  "Test outcomes of the previous attempt, for phase \"reflect\""
    reflections       = list(string, [])  "Lessons from earlier attempts"
    tools             = list({
      name        = string        "Tool name"
      description = string        "What the tool does"
      parameters  = map({})       "Arguments: name to type or description"
      returns     = string("")    "What the tool returns"
    }, [])                        "Tools the agent may call"
    episodic_memory   = list({
      content   = string          "What happened"
      timestamp = string("")      "When it happened"
      source    = string("")      "Where it comes from"
    }, [])                        "Past events"
    semantic_memory   = list({
      content = string            "The fact"
      source  = string("")        "Where it comes from"
    }, [])                        "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, [])                        "Procedures that worked"
    persona_memory    = list({
      content = string            "What is known about the user or the agent"
      source  = string("")        "Where it comes from"
    }, [])                        "Who the user and the agent are"
    working_memory    = list({
      content = string            "The note"
    }, [])                        "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are an agent that gets better by looking back at its own work. You make an attempt, study honestly where it fell short, turn that into concrete lessons, and use the lessons to do better on the next try."
    }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You may call these tools when they help; when a tool would not help, answer without it."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when "timestamp" in m and m.timestamp       { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not ("timestamp" in m and m.timestamp) { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when "name" in m and m.name { text = "- {{ m.name }}" }
          when "content" in m and m.content { text = "  {{ m.content }}" }
          when "steps" in m and m.steps {
            each step in m.steps { text = "  * {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when "name" in m and m.name       { text = "- {{ m.name }}: {{ m.content }}" }
          when not ("name" in m and m.name) { text = "- {{ m.content }}" }
        }
      }
    }

    when phase == "reflect" {
      text = """
        ## Current phase: reflect
        Do not solve the task again. Examine the previous attempt shown below against the task and any feedback:
        - Find what is wrong, missing or unsupported, and say why it happened (a wrong assumption, a skipped check, a misread requirement, a bad tool call).
        - When the attempt is actually correct, say so plainly and do not invent problems.
        - Turn each problem into a lesson that is short, specific and usable on the next attempt; avoid generic advice such as "be more careful".
        - Do not repeat lessons that are already listed among the earlier lessons.

        ## Answer format
        Diagnosis: <what went wrong and why, in a few sentences>
        Lessons:
        - <lesson>
        Plan for the next attempt: <what to do differently, step by step>
        """
    }
    when phase == "revise" {
      text = """
        ## Current phase: revise
        Write a new, complete answer to the task. Apply every lesson listed below, fix the problems of the previous attempt, and keep what it got right.
        Give the improved answer itself, not a description of the changes.
        """
    }
    when phase != "reflect" and phase != "revise" {
      text = """
        ## Current phase: act
        Solve the task directly and give a complete answer. State any assumption you make. When lessons from earlier attempts are listed, follow them.
        """
    }
  }

  placeholder "history"

  message "user" {
    text = "## Task"
    text = "{{ task }}"

    when (phase == "reflect" or phase == "revise") and previous_attempt {
      text = "## Previous attempt"
      text = "{{ previous_attempt }}"
    }
    when phase == "reflect" and feedback {
      text = "## Feedback on the previous attempt"
      text = "{{ feedback }}"
    }
    when phase == "reflect" and test_results {
      text = "## Test results"
      each result in test_results { text = "- {{ result }}" }
    }

    when reflections and phase == "reflect" {
      text = "## Earlier lessons"
      each lesson in reflections { text = "- {{ lesson }}" }
    }
    when reflections and phase != "reflect" {
      text = "## Lessons from earlier attempts"
      each lesson in reflections { text = "- {{ lesson }}" }
    }

    when phase == "reflect"                        { text = "Reflect on the previous attempt." }
    when phase == "revise"                         { text = "Write the improved answer." }
    when phase != "reflect" and phase != "revise" { text = "Answer the task." }
  }
}

/**
 * Example:
 *
 *   builder.render("self_reflection_agent", {
 *       "task": "Write a Python function that returns the n-th Fibonacci number.",
 *       "phase": "reflect",
 *       "previous_attempt": "def fib(n):\n    return fib(n - 1) + fib(n - 2)",
 *       "feedback": "It never stops.",
 *       "test_results": ["fib(0): RecursionError", "fib(5): RecursionError"],
 *       "reflections": ["Check the base cases before the recursive step."],
 *       "semantic_memory": [{"content": "fib(0) = 0 and fib(1) = 1.", "source": "task statement"}],
 *   })
 **/
