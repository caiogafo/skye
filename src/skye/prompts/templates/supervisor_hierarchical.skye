---
title       = "Hierarchical supervisor"
description = "A top-level coordinator that delegates to teams through their leads and merges the team reports into a final answer."
version     = "1.0"
tags        = ["agent", "supervisor"]
---

prompt "supervisor_hierarchical" {
  variables = {
    system_prompt     = string("")        "Replaces the default system instructions when not empty"
    task              = string            "The task the organization must accomplish"
    teams             = list({
      name    = string            "Team name"
      lead    = string            "Who leads the team"
      purpose = string            "What the team does"
      members = list(string, [])  "Team members"
    }, [])                        "Teams"
    team_reports      = list({
      team   = string             "Team name"
      report = string             "What the team reported"
    }, [])                        "Reports received so far"
    progress          = list({
      worker  = string            "Who did the step"
      summary = string            "What came out of it"
    }, [])                        "Steps done so far"
    tools             = list({
      name        = string        "Tool name"
      description = string        "What the tool does"
      parameters  = map({})       "Arguments: name to type or description"
      returns     = string("")    "What the tool returns"
    }, [])                        "Tools the agent may call"
    episodic_memory   = list({
      content   = string          "What happened"
      timestamp = string("")      "When it happened"
      source    = string("")      "Where it comes from"
    }, [])                        "Past events"
    semantic_memory   = list({
      content = string            "The fact"
      source  = string("")        "Where it comes from"
    }, [])                        "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, [])                        "Procedures that worked"
    persona_memory    = list({
      content = string            "What is known about the user or the agent"
      source  = string("")        "Where it comes from"
    }, [])                        "Who the user and the agent are"
    working_memory    = list({
      content = string            "The note"
    }, [])                        "Notes for the current task"
    constraints       = list(string, [])  "Rules to respect"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are the top-level coordinator of an organization made of teams. Each team has a lead who runs its own members; you talk only to the leads. You decide which team takes the next part of the task, and when the teams have reported enough, you combine their reports into one final answer."
    }

    text = "## Teams"
    when teams {
      each team in teams {
        text = "- **{{ team.name }}** (lead: {{ team.lead }}): {{ team.purpose }}"
        when "members" in team and team.members { text = "  Members: {{ team.members | join(', ') }}" }
      }
    }
    when not teams { text = "(no teams were listed; answer with a final answer)" }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You may call these tools when they help; when a tool would not help, answer without it."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when "timestamp" in m and m.timestamp       { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not ("timestamp" in m and m.timestamp) { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when "name" in m and m.name { text = "- {{ m.name }}" }
          when "content" in m and m.content { text = "  {{ m.content }}" }
          when "steps" in m and m.steps {
            each step in m.steps { text = "  * {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when "name" in m and m.name       { text = "- {{ m.name }}: {{ m.content }}" }
          when not ("name" in m and m.name) { text = "- {{ m.content }}" }
        }
      }
    }
    when constraints {
      text = "## Constraints"
      each constraint in constraints { text = "- {{ constraint }}" }
    }

    text = """
      ## How to decide
      - Delegate to one team at a time, by its name, giving its lead a self-contained brief: the lead does not see this conversation.
      - Pick the team whose purpose matches the part of the task that is still open; do not ask a team for work it has already reported.
      - When the reports together answer the task, write the final answer yourself: merge them, settle any disagreement between them, and say what is still uncertain.

      ## Answer format
      Reply with one JSON object and nothing else, in one of these two shapes:
      {"action": "delegate", "team": "<team name>", "reason": "<why this team>", "instructions": "<the brief for the lead>"}
      {"action": "final", "reason": "<why the task is complete>", "answer": "<the final answer built from the team reports>"}
      """
  }

  placeholder "history"

  message "user" {
    text = "## Task"
    text = "{{ task }}"
    when progress {
      text = "## Steps taken so far"
      each step in progress { text = "- {{ step.worker }}: {{ step.summary }}" }
    }
    when team_reports {
      text = "## Team reports"
      each report in team_reports {
        text = "### {{ report.team }}"
        text = "{{ report.report }}"
      }
    }
    when not team_reports { text = "No team has reported yet." }
    text = "Delegate the next part, or give the final answer."
  }
}

/**
 * Example:
 *
 *   builder.render("supervisor_hierarchical", {
 *       "task": "Launch the new website by the end of the month.",
 *       "teams": [
 *           {
 *               "name": "content",
 *               "lead": "editor",
 *               "purpose": "Writes and checks the pages",
 *               "members": ["writer", "proofreader"],
 *           },
 *           {"name": "engineering", "lead": "tech_lead", "purpose": "Builds and deploys the site"},
 *       ],
 *       "team_reports": [{"team": "content", "report": "All twelve pages are written and proofread."}],
 *       "progress": [{"worker": "content", "summary": "Pages written."}],
 *       "constraints": ["Do not change the brand colours."],
 *   })
 **/
