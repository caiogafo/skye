---
title       = "Main agent"
description = "A general assistant with capabilities, past events, known facts, tool output, procedures, domain knowledge and constraints; also takes tools and memories of every kind."
version     = "1.0"
tags        = ["agent", "assistant"]
---

prompt "main_agent" {
  variables = {
    system_prompt       = string("")        "Replaces the default system instructions when not empty"
    personality         = list(string, [])  "Personality traits"
    capabilities = list({
      name        = string      "Capability name"
      description = string("")  "What the agent can do with it"
    }, []) "What the agent can do"
    tools_output        = string("")        "Output of tools already executed, as free text"
    domain_knowledge    = string("")        "Domain knowledge, as free text"
    constraints         = list(string, [])  "Limits to respect"
    input               = string("")        "The user's message"
    response_guidelines = list(string, [])  "How to respond"
    output_format       = string("")        "Free-form response format, e.g. 'markdown'; empty for none"
    thinking_required   = bool(false)       "Ask to think step by step before answering"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt { text = "You are an intelligent AI assistant with comprehensive capabilities. You can help with various tasks including answering questions, analyzing information, generating content, and solving problems. You have access to memory, tools, and specialized knowledge." }
    when personality {
      text = "## Personality"
      text = "{{ personality | join(', ') }}"
    }
    when capabilities {
      text = "## Available Capabilities:"
      each capability in capabilities { text = "- **{{ capability.name }}**: {{ capability.description }}" }
    }

    /**
     * This prompt shows past events, known facts and procedures in its own sections (not under
     * "## Memory"), each memory once.
     **/
    when episodic_memory {
      text = "## Context of things the Human said in the past:"
      each memory in episodic_memory {
        when memory.timestamp     { text = "  - {{ memory.content }} ({{ memory.timestamp }})" }
        when not memory.timestamp { text = "  - {{ memory.content }}" }
      }
    }
    when semantic_memory {
      text = "## Context of documents containing relevant information:"
      each memory in semantic_memory {
        when memory.source     { text = "  - {{ memory.content }} (extracted from {{ memory.source }})" }
        when not memory.source { text = "  - {{ memory.content }}" }
      }
    }
    when tools_output {
      text = "## Context of executed system tools:"
      text = "{{ tools_output }}"
    }
    when procedural_memory {
      text = "## Available procedures:"
      each procedure in procedural_memory {
        when procedure.name and procedure.content     { text = "- {{ procedure.name }}: {{ procedure.content }}" }
        when procedure.name and not procedure.content { text = "- {{ procedure.name }}" }
        when not procedure.name                       { text = "- {{ procedure.content }}" }
        each step in procedure.steps { text = "  * {{ step }}" }
      }
    }
    when domain_knowledge {
      text = "## Domain Knowledge:"
      text = "{{ domain_knowledge }}"
    }
    when constraints {
      text = "## Constraints:"
      each constraint in constraints { text = "- {{ constraint }}" }
    }
    when tools {
      text = "## Tools"
      text = "You can call these tools:"
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when tool.returns    { text = "  Returns: {{ tool.returns }}" }
      }
    }

    when persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }
  }
  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"
    when response_guidelines {
      text = "## Response Guidelines:"
      each guideline in response_guidelines { text = "- {{ guideline }}" }
    }
    when output_format     { text = "Please format your response as {{ output_format }}." }
    when thinking_required { text = "Please think through this step by step before providing your final answer." }
  }
}

/**
 * Example:
 *
 *   builder.render("main_agent", {
 *       "input": "Plan my trip to Lisbon next month.",
 *       "personality": ["friendly", "concise"],
 *       "capabilities": [
 *           {"name": "Travel planning", "description": "Builds day-by-day itineraries"},
 *           {"name": "Budgeting", "description": "Estimates costs"},
 *       ],
 *       "tools_output": "weather(Lisbon, December) -> 15 C, light rain",
 *       "domain_knowledge": "Lisbon's museums close on Mondays.",
 *       "constraints": ["Budget under 1500 EUR", "No flights before 9 am"],
 *       "response_guidelines": ["Use a table for the itinerary"],
 *       "output_format": "markdown",
 *       "thinking_required": True,
 *       "tools": [
 *           {"name": "search_flights", "description": "Finds flights", "parameters": {"from": "airport code", "to": "airport code"}},
 *       ],
 *       "episodic_memory": [{"content": "Went to Porto last spring and loved it", "timestamp": "2026-04-12"}],
 *       "semantic_memory": [{"content": "Lisbon has seven hills", "source": "city guide"}],
 *       "procedural_memory": [{"name": "Book a trip", "steps": ["Pick dates", "Book flights", "Book a hotel"]}],
 *       "persona_memory": [{"content": "Vegetarian", "source": "profile"}],
 *       "working_memory": [{"content": "Dates still to be confirmed"}],
 *       "history": [
 *           {"role": "user", "content": "I want to travel in December."},
 *           {"role": "assistant", "content": "Great, where would you like to go?"},
 *       ],
 *   })
 **/
