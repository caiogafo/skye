---
title       = "Tree-of-thoughts agent"
description = "\"propose\" offers candidate next thoughts from the current path, \"evaluate\" scores candidates, \"solve\" writes the final solution along the chosen path."
version     = "1.0"
tags        = ["agent", "reasoning"]
---

prompt "tree_of_thoughts_agent" {
  variables = {
    system_prompt     = string("")         "Replaces the default system instructions when not empty"
    task              = string             "The task to accomplish"
    phase             = string("propose")  "\"propose\", \"evaluate\" or \"solve\""
    breadth           = number(3)          "How many candidate next thoughts to propose"
    path              = list(string, [])   "Thoughts chosen so far, in order"
    candidates        = list(string, [])   "Candidate next thoughts to judge, for phase \"evaluate\""
    scoring           = string("label")    "\"label\" (sure/likely/impossible) or \"number\" (1 to 10)"
    tools             = list({
      name        = string        "Tool name"
      description = string        "What the tool does"
      parameters  = map({})       "Arguments: name to type or description"
      returns     = string("")    "What the tool returns"
    }, [])                        "Tools the agent may call"
    episodic_memory   = list({
      content   = string          "What happened"
      timestamp = string("")      "When it happened"
      source    = string("")      "Where it comes from"
    }, [])                        "Past events"
    semantic_memory   = list({
      content = string            "The fact"
      source  = string("")        "Where it comes from"
    }, [])                        "Known facts"
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, [])                        "Procedures that worked"
    persona_memory    = list({
      content = string            "What is known about the user or the agent"
      source  = string("")        "Where it comes from"
    }, [])                        "Who the user and the agent are"
    working_memory    = list({
      content = string            "The note"
    }, [])                        "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You solve hard problems by searching over partial solutions. A solution is built as a path of intermediate thoughts; at each point you consider several possible next thoughts, judge which ones are worth pursuing, and continue only along the promising ones."
    }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You may call these tools when they help; when a tool would not help, answer without it."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when episodic_memory or semantic_memory or procedural_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when "timestamp" in m and m.timestamp       { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not ("timestamp" in m and m.timestamp) { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when "source" in m and m.source       { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not ("source" in m and m.source) { text = "- {{ m.content }}" }
        }
      }
      when procedural_memory {
        text = "### Procedures"
        each m in procedural_memory {
          when "name" in m and m.name { text = "- {{ m.name }}" }
          when "content" in m and m.content { text = "  {{ m.content }}" }
          when "steps" in m and m.steps {
            each step in m.steps { text = "  * {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when "name" in m and m.name       { text = "- {{ m.name }}: {{ m.content }}" }
          when not ("name" in m and m.name) { text = "- {{ m.content }}" }
        }
      }
    }

    when phase == "evaluate" {
      text = "## Current phase: evaluate"
      text = "Judge each candidate thought below as a next step after the current path. Ask whether it is correct, whether it moves toward a solution, and whether a solution can still be reached from it. Judge every candidate independently and in the order given; do not continue the solution."
      when scoring == "number" {
        text = """
          Give each candidate a score from 1 (useless or wrong) to 10 (certainly leads to a solution), with a one-line justification.

          ## Answer format
          One line per candidate, in the given order:
          Candidate <n>: <score from 1 to 10> - <one-line justification>
          """
      }
      when scoring != "number" {
        text = """
          Label each candidate with one word: "sure" (it is correct and clearly leads to a solution), "likely" (it is plausible but not yet certain) or "impossible" (it is wrong or makes a solution unreachable), with a one-line justification.

          ## Answer format
          One line per candidate, in the given order:
          Candidate <n>: <sure|likely|impossible> - <one-line justification>
          """
      }
    }
    when phase == "solve" {
      text = """
        ## Current phase: solve
        The path below is the line of thought that was chosen. Follow it step by step, fill in whatever it leaves out, and write the complete final solution.
        When a step of the path turns out to be wrong, correct it and say so briefly.

        ## Answer format
        Solution: <the worked solution along the path>
        Final answer: <the answer only>
        """
    }
    when phase != "evaluate" and phase != "solve" {
      text = "## Current phase: propose"
      text = "Suggest {{ breadth }} different candidates for the next thought after the current path. Each candidate is one concrete step that moves the solution forward; the candidates should explore genuinely different directions, not rephrase each other. Do not solve the whole problem in one candidate."
      text = """

        ## Answer format
        One line per candidate:
        Thought <n>: <the next step>
        """
    }
  }

  placeholder "history"

  message "user" {
    text = "## Problem"
    text = "{{ task }}"

    when path {
      text = "## Current path"
      each thought in path { text = "- {{ thought }}" }
    }
    when not path and phase == "solve" { text = "No path was selected: solve the problem directly." }
    when not path and phase != "solve" { text = "The path is empty: this is the first step." }

    when phase == "evaluate" {
      text = "## Candidates"
      each candidate in candidates { text = "- {{ candidate }}" }
      when not candidates { text = "(no candidates were given)" }
      text = "Evaluate the candidates."
    }
    when phase == "solve"                          { text = "Write the final solution." }
    when phase != "evaluate" and phase != "solve" { text = "Propose exactly {{ breadth }} candidate next thoughts." }
  }
}

/**
 * Example:
 *
 *   builder.render("tree_of_thoughts_agent", {
 *       "task": "Use 4, 9, 10 and 13 with + - * / to make 24.",
 *       "phase": "evaluate",
 *       "path": ["13 - 9 = 4 (left: 4, 4, 10)"],
 *       "candidates": ["10 - 4 = 6 (left: 4, 6)", "4 + 4 = 8 (left: 8, 10)"],
 *       "scoring": "number",
 *       "tools": [
 *           {
 *               "name": "calculator",
 *               "description": "Evaluates an arithmetic expression.",
 *               "parameters": {"expression": "The expression, e.g. 3 * 4.5"},
 *               "returns": "The result as a number",
 *           },
 *       ],
 *   })
 **/
