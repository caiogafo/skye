---
title       = "Procedure agent"
description = "An agent that picks one procedure (or none) for the user's request and answers with a JSON action; takes the procedures, examples, tools and memories."
version     = "1.0"
tags        = ["agent", "procedure", "json"]
---

prompt "procedure_agent" {
  variables = {
    system_prompt = string("")  "Replaces the default system instructions when not empty"
    examples = list({
      question     = string      "Example request"
      action       = string      "Procedure chosen, or no_action"
      action_input = string("")  "Input given to it"
    }, []) "Worked examples"
    input         = string("")  "The user's message"
    tools = list({
      name        = string      "Tool name"
      description = string      "What the tool does"
      parameters  = map({})     "Arguments: name to type or description"
      returns     = string("")  "What the tool returns"
    }, []) "Tools the agent may call"
    persona_memory = list({
      content = string      "What is known about the user or the agent"
      source  = string("")  "Where it comes from"
    }, []) "Who the user and the agent are"
    episodic_memory = list({
      content   = string      "What happened"
      timestamp = string("")  "When it happened"
      source    = string("")  "Where it comes from"
    }, []) "Past events"
    semantic_memory = list({
      content = string      "The fact"
      source  = string("")  "Where it comes from"
    }, []) "Known facts"
    /**
     * procedural_memory holds the procedures to choose from: one with a name can be chosen as the
     * action (its content says what it does); one without a name is a remembered hint, listed
     * under "Relevant procedures from memory".
     **/
    procedural_memory = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, []) "Procedures that worked"
    working_memory = list({
      content = string  "The note"
    }, []) "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      text = "You are an intelligent AI assistant that can execute procedures and forms to help users complete complex tasks. You have access to various procedures and should select the most appropriate one based on the user's request."
    }

    text = "You have access to the following procedures:"
    each procedure in procedural_memory {
      when procedure.name {
        text = "- \"{{ procedure.name }}\": {{ procedure.content }}"
        each step in procedure.steps { text = "  * {{ step }}" }
      }
    }
    when tools {
      text = "## Tools"
      text = "You can call these tools:"
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when tool.returns    { text = "  Returns: {{ tool.returns }}" }
      }
    }

    when episodic_memory or semantic_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          # A "name" key is not part of the shape; it is still shown in front of the note when given.
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }

    text = """
      ## Response Format

      Please respond with a JSON object containing the procedure to execute:

      ```json
      {
          "action": "procedure_name",
          "action_input": "input_for_procedure"
      }
      ```

      If no procedure is needed, respond with:
      ```json
      {
          "action": "no_action",
          "action_input": null
      }
      ```
      """

    when examples {
      text = "## Examples:"
      each example in examples {
        text = """
          Question: {{ example.question }}
          ```json
          {
              "action": "{{ example.action }}",
              "action_input": "{{ example.action_input }}"
          }
          ```
          """
      }
    }

    # The heading only when at least one procedure has no name.
    text = "{{ '## Relevant procedures from memory:' if '' in (procedural_memory | map('name')) else '' }}"
    each memory in procedural_memory {
      when not memory.name { text = "- {{ memory.content }}" }
    }
  }
  placeholder "history"  # earlier turns, from history={"history": [...]} or the variable history

  message "user" {
    text = "{{ input }}"
    text = "Please select the most appropriate procedure to help with this request."
  }
}

/**
 * Example:
 *
 *   builder.render("procedure_agent", {
 *       "input": "I was charged twice for order 42.",
 *       "procedural_memory": [
 *           {"name": "refund", "content": "Refund an order", "steps": ["Check the order", "Refund the duplicate charge"]},
 *           {"name": "open_ticket", "content": "Open a support ticket"},
 *           {"content": "Refunds need an order number"},
 *       ],
 *       "examples": [
 *           {"question": "Give me my money back for order 7", "action": "refund", "action_input": "order 7"},
 *       ],
 *       "tools": [{"name": "order_lookup", "description": "Finds an order by number", "parameters": {"number": "order number"}}],
 *       "episodic_memory": [{"content": "Reported a late delivery for order 40", "timestamp": "2026-10-30"}],
 *       "history": [
 *           {"role": "user", "content": "Hi, I have a billing problem."},
 *           {"role": "assistant", "content": "Sorry to hear that. What happened?"},
 *       ],
 *   })
 **/
