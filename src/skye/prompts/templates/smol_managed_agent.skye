---
title       = "Managed sub-agent (smolagents style)"
description = "Wraps the task a manager agent hands to a team member and asks for a report with a short and a detailed answer."
version     = "1.0"
tags        = ["agent", "smolagents"]
---

prompt "smol_managed_agent" {
  variables = {
    system_prompt      = string("")  "Replaces the default system instructions when not empty"
    name               = string("")  "Name of this team member"
    manager            = string("")  "Name of the manager agent that gave the task"
    task               = string      "The task the manager hands over"
    additional_context = string("")  "Extra context from the manager"
    tools              = list({
      name        = string        "Tool name"
      description = string        "What the tool does"
      parameters  = map({})       "Arguments: name to type or description"
      returns     = string("")    "What the tool returns"
    }, [])                        "Tools the agent may call"
    episodic_memory    = list({
      content   = string          "What happened"
      timestamp = string("")      "When it happened"
      source    = string("")      "Where it comes from"
    }, [])                        "Past events"
    semantic_memory    = list({
      content = string            "The fact"
      source  = string("")        "Where it comes from"
    }, [])                        "Known facts"
    procedural_memory  = list({
      name    = string("")        "Procedure name"
      content = string("")        "How to do it, as text"
      steps   = list(string, [])  "How to do it, as steps"
    }, [])                        "Procedures that worked"
    persona_memory     = list({
      content = string            "What is known about the user or the agent"
      source  = string("")        "Where it comes from"
    }, [])                        "Who the user and the agent are"
    working_memory     = list({
      content = string            "The note"
    }, [])                        "Notes for the current task"
  }

  message "system" {
    when system_prompt     { text = "{{ system_prompt }}" }
    when not system_prompt {
      when name     { text = "You are {{ name }}, an agent working as a member of a team." }
      when not name { text = "You are an agent working as a member of a team." }
      text = "A manager agent has given you a task. Carry it out as well as you can, then report back: the manager sees only your final report, not the steps you took to get there."
    }

    /** Optional tools, one line each with their parameters and what they return. **/
    when tools {
      text = "## Tools"
      text = "You can use these tools:"
      each tool in tools {
        text = "- `{{ tool.name }}`: {{ tool.description }}"
        when "parameters" in tool and tool.parameters {
          text = "    Arguments:"
          each param in tool.parameters { text = "    - `{{ param.key }}`: {{ param.value }}" }
        }
        when "returns" in tool and tool.returns { text = "    Returns: {{ tool.returns }}" }
      }
    }

    /** Optional memories, one subsection per kind, each shown only when given. **/
    when persona_memory or semantic_memory or episodic_memory or procedural_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona (who the user and you are, and their preferences)"
        each m in persona_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
      when episodic_memory {
        text = "### Past interactions"
        each m in episodic_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
      when procedural_memory {
        text = "### Procedures you know"
        each m in procedural_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if ('name' in m and m.name) and ('content' in m and m.content) }}{{ m.content if 'content' in m and m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
          when "steps" in m and m.steps {
            each step in m.steps { text = "    - {{ step }}" }
          }
        }
      }
      when working_memory {
        text = "### Working notes for this task"
        each m in working_memory {
          text = "- {{ m.name if 'name' in m and m.name }}{{ ': ' if 'name' in m and m.name }}{{ m.content }}{{ ' (' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}{{ m.timestamp if 'timestamp' in m and m.timestamp }}{{ ', ' if ('timestamp' in m and m.timestamp) and ('source' in m and m.source) }}{{ 'source: ' if 'source' in m and m.source }}{{ m.source if 'source' in m and m.source }}{{ ')' if ('timestamp' in m and m.timestamp) or ('source' in m and m.source) }}"
        }
      }
    }
  }

  placeholder "history"

  message "user" {
    text = "Task from {{ manager if manager else 'your manager' }}:"
    text = "{{ task }}"
    when additional_context {
      text = "## Additional context"
      text = "{{ additional_context }}"
    }
    text = """
      Your report is all the manager will get, so make it self-contained. Put the whole report in your final answer, laid out like this:

      ### 1. Short answer
      The result in one or two sentences.
      ### 2. Detailed answer
      The full result, with the facts, figures and reasoning behind it.
      ### 3. Additional context
      Anything else worth knowing: sources, assumptions, what you could not check, ideas for next steps.

      If you could not finish, say so plainly and report what you did find and what is still missing; a partial report is far more useful than none.
      """
  }
}

/**
 * Example:
 *
 *   builder.render("smol_managed_agent", {
 *       "name": "researcher",
 *       "manager": "lead",
 *       "task": "Find the population of Milan in 2025 and give the source.",
 *       "additional_context": "The report is due today.",
 *       "tools": [
 *           {
 *               "name": "web_search",
 *               "description": "Searches the web and returns the top results.",
 *               "parameters": {"query": "What to search for"},
 *               "returns": "A list of titles and links",
 *           },
 *       ],
 *       "semantic_memory": [{"content": "The user lives in Milan.", "source": "profile"}],
 *   })
 **/
