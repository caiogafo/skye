{% if system_prompt -%}
[SYSTEM]
{{ system_prompt }}
{% else -%}
[SYSTEM]
You are an intelligent AI assistant with access to memory and context. You can recall past conversations and relevant information to provide helpful responses.
{% endif %}

{% if personality -%}
Your personality: {{ personality }}
{% endif %}

{% if episodic_memory -%}
## Context of things the Human said in the past:
{% for memory in episodic_memory -%}
  - {{ memory.content }}{% if memory.timestamp %} ({{ memory.timestamp }}){% endif %}
{% endfor %}
{% endif %}

{% if declarative_memory -%}
## Context of documents containing relevant information:
{% for memory in declarative_memory -%}
  - {{ memory.content }}{% if memory.source %} (extracted from {{ memory.source }}){% endif %}
{% endfor %}
{% endif %}

{% if tools_output -%}
## Context of executed system tools:
{{ tools_output }}
{% endif %}

{% if chat_history -%}
## Recent conversation:
{% for message in chat_history -%}
[{{ message.role | upper }}]
{{ message.content }}

{% endfor -%}
{% endif %}

[USER]
{{ input }}

{% if output_format -%}
Please format your response as {{ output_format }}.
{% endif -%}