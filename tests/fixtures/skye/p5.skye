# P5. Output schema (version 1 since D70): the answer is a JSON object with these fields.
prompt "extract_invoice" {
  variables = { document = string }
  output {
    vendor   = string
    total    = number
    currency = string("EUR")
    lines    = list({ description = string, amount = number })
  }
  message "user" { text = "Extract the invoice fields from the document.\n{{ document }}" }
}
